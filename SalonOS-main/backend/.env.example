# ==============================================================================
# SalonOS — Environment Configuration
# Copy this file to .env in backend directory and adjust the values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Metadata
# ------------------------------------------------------------------------------
APP_NAME=SalonOS
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# ------------------------------------------------------------------------------
# CORS (comma-separated origins or JSON array)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=salonos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salonos_db

# Optional direct connection URL override (takes precedence if set):
# DATABASE_URL=postgresql+psycopg://salonos:change-me@localhost:5432/salonos_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret-key-for-local-dev
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
